# ===== Go-Docs configuration =====
# Copy to .env and adjust. Real environment variables override values in .env.

# Port the server listens on (inside the container too)
PORT=3000
# Port published on the host by docker-compose
HOST_PORT=3000

# Max request body size in MB (base64 images make bodies large)
BODY_LIMIT_MB=20

# Allow <img src="http(s)://..."> to be downloaded by the server.
# Keep false unless you trust every caller: true lets them make the server fetch URLs (SSRF).
ALLOW_REMOTE_IMAGES=false

# Comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=*
